# --- Discord ---
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_GUILD_ID=1520089164744495234

# Live stat channels (locked voice channels the bot RENAMES — no repeated posting).
# Create them, then paste their ids. Leave blank to disable any of them.
PRICE_STAT_CHANNEL_ID=      # -> "💰 ABA $0.0021"
MEMBER_STAT_CHANNEL_ID=     # -> "👥 Members: 42"
MINER_STAT_CHANNEL_ID=      # -> "⛏️ Miners: 7"

# --- Verification method: tx (recommended) | sig | trust ---
VERIFY_METHOD=tx
# For VERIFY_METHOD=tx: a wallet the bot controls. Users send a free tx here to prove
# ownership; the bot links them and sends it back. Fund it with a little ABA for refunds.
VERIFY_ADDRESS=0x...
VERIFY_PRIVKEY=0x...        # keep secret; only needs enough ABA to refund test amounts

# --- Abakos chain (defaults are correct; override only if endpoints change) ---
# EVM_RPC=https://evm-rpc.abakos.ai
# COSMOS_REST=https://rest.abakos.ai
# AGENT_STATS=https://explorer.abakos.ai/agent/stats

# --- Tuning ---
# HOLDER_MIN_ABA=0
# SYNC_INTERVAL_MS=1800000
# STAT_INTERVAL_MS=900000
# VERIFY_SCAN_INTERVAL_MS=20000
