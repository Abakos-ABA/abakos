# Keep vendored chain code and shell scripts as LF so Linux/WSL builds are stable
chain/** text eol=lf
chain-sdk/** text eol=lf
scripts/*.sh text eol=lf
legacy/** text eol=lf

# WASM test fixtures are binary; the text rule above must not touch their bytes
*.wasm binary
*.wasm.* binary
*.wasm.gzip binary
